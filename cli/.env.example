# margin-monitor environment. Copy to .env and fill in (Anvil defaults shown).
# Local Anvil node.
RPC_URL=http://127.0.0.1:8545

# Signer keys for the two actors (Anvil deterministic keys from LibConstants).
# price update signs with VALUATION_PROVIDER_KEY; check/watch with COLLATERAL_AGENT_KEY.
VALUATION_PROVIDER_KEY=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e
COLLATERAL_AGENT_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba

# Path to the Foundry deployment artifact (default repo-relative).
DEPLOY_JSON=../deployments/anvil.json

# Asset id for price updates (T-BOND-001 or CORP-BOND-001).
ASSET_ID=T-BOND-001
